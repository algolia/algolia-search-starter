# ──────────────────────────────────────────────────────────────────────────
# All three variables are injected automatically into your Vercel project
# when you install the Algolia integration from the Vercel Marketplace:
# https://vercel.com/marketplace/algolia-production
#
# For local development, pull them from Vercel instead of filling this file:
#   vercel link
#   vercel env pull .env.local
# ──────────────────────────────────────────────────────────────────────────

# Your Algolia application ID.
# Exposed to the browser as NEXT_PUBLIC_ALGOLIA_APP_ID (see next.config.ts).
ALGOLIA_APP_ID=

# Search-only API key — safe for the browser.
# Exposed to the browser as NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY (see next.config.ts).
ALGOLIA_SEARCH_API_KEY=

# Write API key — SERVER-SIDE ONLY. Used by `npm run seed`.
# Never expose this to the browser, never prefix it with NEXT_PUBLIC_.
ALGOLIA_WRITE_API_KEY=
